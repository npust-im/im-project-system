rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isCommittee() {
      return signedIn() && role() == 'committee';
    }

    function under50MB() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && under50MB();
      allow delete: if isAdmin();
    }

    match /groups/{groupId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == groupId || isCommittee() || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == groupId && under50MB();
      allow delete: if signedIn() && (request.auth.uid == groupId || isAdmin());
    }

    match /committee/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid && under50MB();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // 取代封面時上傳至新路徑，資料庫寫入成功後才刪除舊檔。
    match /committee/{uid}/{fileName} {
      allow create: if isAdmin()
        && resource == null
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.role == 'committee'
        && fileName.matches('passbook_[0-9]+_[a-f0-9]{32}[.](pdf|jpg|jpeg|png)')
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png')
        && request.resource.size > 0
        && under50MB();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
